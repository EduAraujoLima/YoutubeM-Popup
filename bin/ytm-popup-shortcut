#!/usr/bin/env bash
# Configura o atalho de teclado do MATE para o ytm-popup.
#   ytm-popup-shortcut                  -> Super+M
#   ytm-popup-shortcut '<Primary><Alt>m' -> Ctrl+Alt+M
#   ytm-popup-shortcut --remove         -> remove o atalho
#   ytm-popup-shortcut --first-run      -> só configura se nunca foi feito
set -u
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/ytm-popup"
STAMP="$CONF/.shortcut-done"
BASE=/org/mate/desktop/keybindings
command -v dconf >/dev/null || { echo "dconf não encontrado" >&2; exit 1; }

find_slot() {
  local free=""
  for i in $(seq 0 99); do
    local p="$BASE/custom$i/" a
    a="$(dconf read "${p}action" 2>/dev/null)"
    if [[ "$a" == *ytm-popup* ]]; then echo "$p"; return; fi
    [[ -z "$free" && -z "$a" ]] && free="$p"
  done
  echo "$free"
}

case "${1:-}" in
  --first-run)
    [ -f "$STAMP" ] && exit 0
    set -- "<Mod4>m" ;;
  --remove)
    for i in $(seq 0 99); do
      p="$BASE/custom$i/"
      [[ "$(dconf read "${p}action" 2>/dev/null)" == *ytm-popup* ]] && dconf reset -f "$p"
    done
    rm -f "$STAMP"; echo "Atalho removido."; exit 0 ;;
esac

BINDING="${1:-<Mod4>m}"
slot="$(find_slot)"
[ -n "$slot" ] || { echo "Sem espaço para atalhos personalizados" >&2; exit 1; }
dconf write "${slot}name" "'YT Music Popup'"
dconf write "${slot}action" "'ytm-popup'"
dconf write "${slot}binding" "'$BINDING'"
mkdir -p "$CONF"; touch "$STAMP"
echo "Atalho configurado: $BINDING"
